{
  "name": "web",
  "private": true,
  "version": "0.7.2",
  "type": "module",
  "packageManager": "pnpm@11.0.8+sha512.4c4097e1dd2d42372c4e7fa5a791ff28fc75a484c7ac192e64b1df0fdef17594ba982f9b4fed9adfb3c757846f565b799b2763fb3733d1de1bcb82cf46684912",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.0.0"
  },
  "scripts": {
    "dev": "pnpm generate:payment-data && react-router dev",
    "build": "pnpm generate:payment-data && react-router build && tsx scripts/generate-sitemap.ts",
    "generate:payment-data": "tsx scripts/generate-payment-top-offers.ts --write",
    "check:generated": "tsx scripts/generate-payment-top-offers.ts --check",
    "check": "pnpm check:generated && pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run -c vitest.config.ts",
    "test:watch": "vitest -c vitest.config.ts",
    "lint": "eslint .",
    "preview": "vite preview --outDir dist/client"
  },
  "dependencies": {
    "@react-router/node": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "isbot": "^5",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.3.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
}
